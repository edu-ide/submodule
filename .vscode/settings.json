{
  "python.defaultInterpreterPath": "${workspaceFolder}/server/.venv/bin/python3",
  "rust-analyzer.linkedProjects": ["./server/Cargo.toml"],
  "python.analysis.extraPaths": [],
  "python.autoComplete.extraPaths": [],
  "python.testing.pytestArgs": ["server"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "args": ["-l"]
    }
  },
  "search.useIgnoreFiles": false,
  "search.exclude": {
    "**/binary": true,
    "**/core/vendor/**": true,
    "**/gui/dist": true,
    "backend/demo/build/generated-sources/openapi-interfaces/src/main/java/com/example/demo/api/**": false
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "backend/demo/build/generated-sources/openapi-interfaces/src/main/java/com/example/demo/api/**": false

  },

  "java.configuration.updateBuildConfiguration": "automatic",
  "java.autobuild.enabled": true,
  "java.compile.nullAnalysis.mode": "automatic",
  "java.server.launchMode": "Standard",
  "editor.formatOnSave": true,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Xlog:disable"
}
