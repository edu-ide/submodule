#### 5. Pages (페이지)
```tsx
// components/pages/auth/LoginPage/LoginPage.tsx
import React, { useState } from 'react';
import { toast } from 'react-hot-toast';
import { useAuth } from '@microblog/contexts/AuthContext';
import LoginTemplate from '@microblog/components/templates/auth/LoginTemplate';
import { AuthApi, LoginRequest } from '@microblog/openapi-axios';
import { createOpenApiConfig } from '@microblog/utils/api';

const LoginPage: React.FC = () => {
  const { login: authLogin } = useAuth();
  const [isLoading, setIsLoading] = useState(false);
  
  const handleLogin = async (username: string, password: string) => {
    try {
      setIsLoading(true);
      
      // API 클라이언트 생성
      const config = createOpenApiConfig();
      const apiClient = new AuthApi(config);
      
      // 로그인 API 호출
      const response = await apiClient.authLogin({
        loginRequest: {
          username,
          password,
          rememberMe: true
        }
      });
      
      // 사용자 정보 가져오기
      const userResponse = await apiClient.authMe({
        headers: {
          Authorization: `Bearer ${response.data.token}`
        }
      });
      
      // 컨텍스트 업데이트
      const userData = {
        id: String(userResponse.data.id),
        name: userResponse.data.displayName,
        username: userResponse.data.username,
        profileImage: userResponse.data.profileImageUrl
      };
      
      await authLogin(userData);
      toast.success('로그인 성공!');
      return true;
    } catch (error) {
      toast.error('로그인에 실패했습니다');
      return false;
    } finally {
      setIsLoading(false);
    }
  };
  
  return <LoginTemplate onLogin={handleLogin} isLoading={isLoading} />;
};

export default LoginPage;
```

### VSCode 웹뷰 통합

```tsx
// vscode-integration.ts
import { VSCodeMessage, VSCodeAPI } from '@microblog/types/vscode';

// VSCode API 접근 (웹뷰 환경에서만 사용 가능)
let vscode: VSCodeAPI | undefined;

try {
  // @ts-ignore - VSCode API는 전역 객체로 제공됨
  vscode = acquireVsCodeApi();
} catch (e) {
  console.log('VSCode API를 사용할 수 없습니다. 웹 환경에서 실행 중입니다.');
}

// VSCode와 메시지 교환
export const sendMessageToVSCode = (message: VSCodeMessage) => {
  if (vscode) {
    vscode.postMessage(message);
  } else {
    console.log('VSCode 메시지 (웹 환경):', message);
  }
};

// VSCode 메시지 수신
export const useVSCodeMessages = (callback: (message: any) => void) => {
  useEffect(() => {
    const handler = (event: MessageEvent) => {
      callback(event.data);
    };
    
    window.addEventListener('message', handler);
    return () => window.removeEventListener('message', handler);
  }, [callback]);
};
```

## 4. 풀스택 개발 워크플로우

### 기능 개발 흐름

1. **API 명세 정의**
   - OpenAPI 스펙으로 API 정의
   - `/backend/demo/src/main/resources/openapi/` 디렉토리에 추가

2. **코드 생성**
   ```bash
   cd backend/demo
   ./gradlew generateAll
   ```

3. **백엔드 구현**
   - 도메인 모델 정의
   - 명령(Command) 및 쿼리(Query) 클래스 구현
   - API 인터페이스 구현

4. **프론트엔드 구현**
   - 아토믹 디자인 원칙에 따라 컴포넌트 구현
   - 생성된 API 클라이언트 사용
   - 필요한 경우 VSCode 웹뷰 통합

### 공통 데이터 모델 동기화

1. **도메인 모델 → DTO → API 모델 → TypeScript 모델** 흐름 유지
2. API 변경 시 항상 `generateAll`로 동기화

## 5. 테스트 및 배포

### 백엔드 테스트

```java
@SpringBootTest
class TweetCommandServiceTest {
    @Autowired
    private TweetCommandService commandService;
    
    @Autowired
    private TweetRepository tweetRepository;
    
    @Test
    void createTweet_ShouldCreateTweetWithCorrectContent() {
        // 준비
        CreateTweetCommand command = new CreateTweetCommand(1L, "테스트 트윗", List.of());
        
        // 실행
        Long tweetId = commandService.createTweet(command);
        
        // 검증
        Tweet tweet = tweetRepository.findById(tweetId).orElseThrow();
        assertEquals("테스트 트윗", tweet.getContent());
        assertEquals(1L, tweet.getAuthor().getId());
    }
}
```

### 프론트엔드 테스트

```tsx
// LoginForm.test.tsx
import { render, screen, fireEvent } from '@testing-library/react';
import LoginForm from './LoginForm';

test('form submission with correct values', async () => {
  const mockSubmit = jest.fn().mockResolvedValue(true);
  
  render(<LoginForm onSubmit={mockSubmit} />);
  
  // 입력
  fireEvent.change(screen.getByLabelText('사용자명'), {
    target: { value: 'testuser' }
  });
  
  fireEvent.change(screen.getByLabelText('비밀번호'), {
    target: { value: 'password123' }
  });
  
  // 제출
  fireEvent.click(screen.getByText('로그인'));
  
  // 검증
  expect(mockSubmit).toHaveBeenCalledWith('testuser', 'password123');
});
```

### 배포 준비

